{
  "coupons": [
    {
      "code": "SAVE10",
      "type": "percent",
      "discount_value": 10,
      "min_order_amount": 300000,
      "expired_at": "2099-12-31",
      "max_uses_per_user": 1,
      "description": "Percent coupon - 10% off"
    },
    {
      "code": "BIGBUY",
      "type": "fixed",
      "discount_value": 50000,
      "min_order_amount": 500000,
      "expired_at": "2099-12-31",
      "max_uses_per_user": 1,
      "description": "Fixed coupon - 50,000 off"
    },
    {
      "code": "VIP100",
      "type": "fixed",
      "discount_value": 100000,
      "min_order_amount": 300000,
      "expired_at": "2099-12-31",
      "max_uses_per_user": 2,
      "description": "Fixed coupon - 100,000 off"
    },
    {
      "code": "EXPIRED",
      "type": "percent",
      "discount_value": 20,
      "min_order_amount": 100000,
      "expired_at": "2020-01-01",
      "max_uses_per_user": 1,
      "description": "Expired coupon - should fail"
    }
  ],
  "testScenarios": [
    {
      "id": "TC01",
      "couponCode": "SAVE10",
      "totalAmount": 500000,
      "userId": 2,
      "expectedDiscount": 50000,
      "expectedFinal": 450000,
      "expectedSuccess": true,
      "description": "Valid percent coupon"
    },
    {
      "id": "TC02",
      "couponCode": "BIGBUY",
      "totalAmount": 600000,
      "userId": 2,
      "expectedDiscount": 50000,
      "expectedFinal": 550000,
      "expectedSuccess": true,
      "description": "Valid fixed coupon"
    },
    {
      "id": "TC03",
      "couponCode": "SAVE10",
      "totalAmount": 200000,
      "userId": 2,
      "expectedDiscount": 0,
      "expectedFinal": 200000,
      "expectedSuccess": false,
      "description": "Below minimum order amount"
    },
    {
      "id": "TC04",
      "couponCode": "EXPIRED",
      "totalAmount": 500000,
      "userId": 2,
      "expectedDiscount": 0,
      "expectedFinal": 500000,
      "expectedSuccess": false,
      "description": "Expired coupon"
    },
    {
      "id": "TC05",
      "couponCode": "NONEXISTENT",
      "totalAmount": 500000,
      "userId": 2,
      "expectedDiscount": 0,
      "expectedFinal": 500000,
      "expectedSuccess": false,
      "description": "Non-existent coupon"
    },
    {
      "id": "TC06",
      "couponCode": "SAVE10",
      "totalAmount": 300000,
      "userId": 2,
      "expectedDiscount": 30000,
      "expectedFinal": 270000,
      "expectedSuccess": true,
      "description": "Exact minimum order amount"
    },
    {
      "id": "TC07",
      "couponCode": "SAVE10",
      "totalAmount": 299999,
      "userId": 2,
      "expectedDiscount": 0,
      "expectedFinal": 299999,
      "expectedSuccess": false,
      "description": "Just below minimum order"
    },
    {
      "id": "TC08",
      "couponCode": "VIP100",
      "totalAmount": 500000,
      "userId": 2,
      "expectedDiscount": 100000,
      "expectedFinal": 400000,
      "expectedSuccess": true,
      "description": "Fixed coupon with high value"
    },
    {
      "id": "TC09",
      "couponCode": "",
      "totalAmount": 500000,
      "userId": 2,
      "expectedDiscount": 0,
      "expectedFinal": 500000,
      "expectedSuccess": false,
      "description": "Empty coupon code"
    },
    {
      "id": "TC10",
      "couponCode": "SAVE10",
      "totalAmount": 1000000,
      "userId": 2,
      "expectedDiscount": 100000,
      "expectedFinal": 900000,
      "expectedSuccess": true,
      "description": "Large order with percent coupon"
    },
    {
      "id": "TC11",
      "couponCode": "BIGBUY",
      "totalAmount": 500000,
      "userId": 2,
      "expectedDiscount": 50000,
      "expectedFinal": 450000,
      "expectedSuccess": true,
      "description": "Exact minimum for fixed coupon"
    },
    {
      "id": "TC12",
      "couponCode": "BIGBUY",
      "totalAmount": 499999,
      "userId": 2,
      "expectedDiscount": 0,
      "expectedFinal": 499999,
      "expectedSuccess": false,
      "description": "Just below minimum for fixed coupon"
    }
  ]
}
